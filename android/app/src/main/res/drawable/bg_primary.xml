<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2C65D4" android:endColor="#188F9E" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#315FC8" android:endColor="#167E91" />
            <stroke android:width="1dp" android:color="#6AA2FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
