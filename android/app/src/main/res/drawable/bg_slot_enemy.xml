<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A1C2A" />
            <stroke android:width="1dp" android:color="@color/danger" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="180" android:startColor="#2B1726" android:endColor="#0B1728" />
            <stroke android:width="1dp" android:color="#633044" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
