<?xml version="1.0" encoding="utf-8"?>
<!-- One lane of the draft board: ally slot | lane pill (sets the target lane) | enemy slot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/allySlot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_slot_empty"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="8dp">

        <com.xiagu.bp.HeroAvatarView
            android:id="@+id/allyAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:id="@+id/allyTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allyName"
                style="@style/Text.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/allyMeta"
                style="@style/Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/laneTouch"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/lanePill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_lane_pill"
            android:duplicateParentState="true"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_lane_pill"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/enemySlot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_slot_empty"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="7dp">

        <LinearLayout
            android:id="@+id/enemyTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/enemyName"
                style="@style/Text.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end" />

            <TextView
                android:id="@+id/enemyMeta"
                style="@style/Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1" />
        </LinearLayout>

        <com.xiagu.bp.HeroAvatarView
            android:id="@+id/enemyAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
