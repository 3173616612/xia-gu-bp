<?xml version="1.0" encoding="utf-8"?>
<!-- Floating panel over the game. Results come first; re-scan stays pinned at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayPanelRoot"
    android:layout_width="340dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_panel"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/openFullPanelButton"
            style="@style/Widget.XiaGu.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="打开峡谷 BP 主界面"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/overlayStatus"
                style="@style/Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="切回游戏后点下方按钮识别"
                android:textColor="@color/mist" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/collapseOverlayButton"
            style="@style/Widget.XiaGu.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="收起悬浮窗"
            android:src="@drawable/ic_minus" />

        <ImageButton
            android:id="@+id/stopOverlayButton"
            style="@style/Widget.XiaGu.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="关闭悬浮助手"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/overlayLaneGroup"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:contentDescription="待补位置"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/seam" />

    <ScrollView
        android:id="@+id/overlayScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/overlayEmpty"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:text="切到游戏的选将界面，点下方「识别 BP 画面」。识别前悬浮窗会自动隐藏，截图只在本机识别，不会上传。" />

            <LinearLayout
                android:id="@+id/recommendationSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/overlayRecommendationList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="点「不想玩」会换入下一顺位，重新识别后恢复。" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detectedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="我方"
                        android:textColor="@color/ally"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/detectedAllies"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="敌方"
                        android:textColor="@color/enemy"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/detectedEnemies"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Number"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="BAN"
                        android:textColor="@color/dusk"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/detectedBans"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detectionIssues"
                    style="@style/Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/caution_text"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/openMatchupAnalysisButton"
                    style="@style/Widget.XiaGu.Button.Small.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="-10dp"
                    android:layout_marginTop="4dp"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="2dp"
                    android:text="阵容对位分析"
                    android:textColor="@color/ally_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/bg_overlay_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/scanButton"
            style="@style/Widget.XiaGu.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="识别 BP 画面"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:text="我方"
            android:textColor="@color/ally"
            android:textSize="11sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/overlaySideGroup"
            android:layout_width="84dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_segment_group"
            android:contentDescription="我方在屏幕哪一侧"
            android:orientation="horizontal"
            android:padding="2dp">

            <RadioButton
                android:id="@+id/overlaySideLeft"
                style="@style/Widget.XiaGu.Segment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="我方在左侧"
                android:text="左"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/overlaySideRight"
                style="@style/Widget.XiaGu.Segment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:contentDescription="我方在右侧"
                android:text="右"
                android:textSize="12sp" />
        </RadioGroup>
    </LinearLayout>
</LinearLayout>
