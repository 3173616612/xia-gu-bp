<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayScroll"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="峡谷 BP · 悬浮助手"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlayMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="巅峰千强 · OCR 待命"
                    android:textColor="@color/cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/collapseOverlayButton"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_outline"
                android:text="收起"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/stopOverlayButton"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_outline"
                android:text="关闭"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_outline"
            android:padding="10dp"
            android:text="切回游戏后点击下方按钮识别当前 BP 画面。"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="待补位置"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/overlayLaneGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/switchTeamSideButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline"
                android:text="我方在左"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/openFullPanelButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline"
                android:text="完整面板"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary"
            android:text="识别当前阵容与 BAN 位"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/detectedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/detectedAllies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/detectedEnemies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/detectedBans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/danger"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/detectionIssues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recommendationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐英雄"
                android:textColor="@color/blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recommendationOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_outline"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recommendationTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_outline"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/recommendationThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_outline"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="所有关系来自巅峰千强实时样本；人数异常和多分路只影响置信度，不会阻止推荐。"
                android:textColor="@color/muted_2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
